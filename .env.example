# 后端环境变量模板

# 数据库（开发默认 SQLite，零配置开箱即用）
DATABASE_URL=sqlite+aiosqlite:///./trip_agent.db
# 如需使用本地 MySQL，替换为：
# DATABASE_URL=mysql+aiomysql://root:password@localhost:3306/trip-agent

SECRET_KEY=change-me-to-a-random-secret
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
MAX_CONTEXT_TOKENS=6000
CORS_ORIGINS=http://localhost:3000

# 天气工具（weatherapi.com）
WEATHER_API_KEY=your-weather-api-key-here

# 高德地图（交通引导 / POI 景点查询工具）
AMAP_API_KEY=your-amap-api-key-here

# SiliconFlow（向量记忆 embedding，可降级：无 key 时不启用）
# 需在 https://cloud.siliconflow.cn 注册获取，模型 BAAI/bge-m3
SILICONFLOW_API_KEY=change-me-to-a-siliconflow-api-key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3

# 向量记忆
MEMORY_TOPK=3
MEMORY_SIM_THRESHOLD=0.45

# POI 景点查询缓存（秒，1 天）
POI_CACHE_TTL=86400
